{
  // Gutschein (gutschein.cleebration.com) – Cloudflare Worker mit statischer Seite und D1 tool-gutschein (Projekt Tool Gutschein)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tool-gutschein",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "gutschein.cleebration.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Rückfallwerte, falls der Store nicht erreichbar ist. Maßgeblich sind die Werte im Store (/admin/sets → Gutschein → Einstellungen).
  "vars": { "OFFEN_FREI": "10", "LOESCHEN_MONATE": "12" },
  "d1_databases": [
    // database_id setzt gutschein-veroeffentlichen.command beim ersten Lauf (wrangler d1 create tool-gutschein)
    { "binding": "DB", "database_name": "tool-gutschein", "database_id": "57bc145f-705a-4f39-8292-bf41bfe4bb2a", "migrations_dir": "migrations" }
  ],
  // Erledigte Gutscheine nach der Lösch-Frist entfernen: täglich 03:23 UTC (Einladung 03:17, Terminfinder 03:29)
  "triggers": { "crons": ["23 3 * * *"] }
  // Geheimnis (wrangler secret put): STORE_SCHLUESSEL – Store → /admin/team/tools → Gutschein → Schlüssel erzeugen
}
